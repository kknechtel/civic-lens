# /etc/long-beach.env — Long Beach deployment on the shared EC2 box.
# chmod 600; owned by root. Nothing here is shared with Atlantic Highlands
# except, optionally, the AI keys you choose to reuse.
DEPLOYMENT=long-beach-ny
PUBLIC_ORIGIN=https://longbeach.ahnj.info
ALLOWED_ORIGINS=https://longbeach.ahnj.info

# Its own database on the existing RDS instance. setup.sh fills this in from
# /etc/atlantic-highlands.env and creates the database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-RDS-HOST:5432/civiclens_lb

# Distinct secrets — never AH's. setup.sh generates these if left blank.
JWT_SECRET=
AI_KEYS_SECRET=

# Files on local disk (the box's EBS volume), not AH's S3 bucket.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/var/lib/long-beach/storage

# Keyword search needs no keys (93% on the Long Beach eval). To add semantic
# search later: put a Voyage key in Admin → AI, set this to voyage, restart
# lb-api, and run: python -m scripts.generate_embeddings
EMBEDDINGS_PROVIDER=none

# Optional AI keys. You can also add these in the app: Admin → AI.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
