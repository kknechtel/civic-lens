# ── Which town ──────────────────────────────────────────────────────────────
# A directory under municipalities/ (e.g. long-beach-ny, atlantic-highlands-nj)
MUNICIPALITY=long-beach-ny

# ── Required ────────────────────────────────────────────────────────────────
# >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civiclens

# ── Storage ─────────────────────────────────────────────────────────────────
# local = files on disk (LOCAL_STORAGE_DIR); auto = S3 when reachable, else local
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: load secrets from AWS Secrets Manager (takes precedence over env)
AWS_SECRETS_NAME=

# ── AI (all optional — the app runs keyless with keyword search) ────────────
# Chat assistant, reports, meeting summaries
ANTHROPIC_API_KEY=
# Document titles/summaries/classification (one flash-lite call per doc)
GEMINI_API_KEY=
# Semantic embeddings; without it search falls back to keyword + hash vectors
VOYAGE_API_KEY=
# Lists YouTube channels (YouTube's robots.txt disallows the RSS feed)
YOUTUBE_API_KEY=
# Whisper fallback for meeting transcription
OPENAI_API_KEY=
WHISPER_MODEL=base

# ── Scraper ─────────────────────────────────────────────────────────────────
# Leave robots.txt compliance on. Per-source opt-outs live in the profile and
# require a recorded permission_note.
RESPECT_ROBOTS_TXT=true
SCRAPER_USER_AGENT=
# Sample N docs per source (first runs / testing a new profile). 0 = all.
SCRAPER_MAX_DOCS_PER_SOURCE=0

# ── OCR resource limits (see services/tesseract_ocr.py) ────────────────────
TESSERACT_WORKERS=
OCR_MAX_PIXELS=12000000
OCR_PAGE_TIMEOUT=90
MAX_OCR_PAGES=60
MAX_OCR_PDF_MB=150
PROCESS_CONCURRENCY=2

# ── Web ─────────────────────────────────────────────────────────────────────
PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
DIGEST_FROM_EMAIL=
